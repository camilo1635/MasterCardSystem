# Copiar a .env (no versionar) o definir como variables de entorno.
# Base de datos (docker compose: localhost:5433)
DB_URL=jdbc:postgresql://localhost:5433/mastercard
DB_USER=mastercard
DB_PASSWORD=cambiar

# JWT: mínimo 32 caracteres aleatorios (p. ej. `openssl rand -base64 48`). Obligatorio fuera del perfil dev.
JWT_SECRET=
# true en producción (https); false solo en dev con http
COOKIE_SECURE=true

# Usuario inicial (único dueño) (solo se usa si la tabla app_user está vacía). Contraseña: 10 a 72 caracteres.
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:4200
